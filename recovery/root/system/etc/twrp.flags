# point                 fstype     block                          block2                    flags

# logical (added logical specific partitions)
/system_image            emmc       /dev/block/by-name/system                               flags=display="System Image";backup=1;flashimg=1
/product_image           emmc       /dev/block/by-name/product                              flags=display=Product Image";backup=1;flashimg=1
/vendor_image            emmc	      /dev/block/mapper/vendor                                flags=display="Vendor Image";backup=1;flashimg=1
/odm_image               emmc       /dev/block/mapper/odm                                   flags=display="Odm Image";backup=1;flashimg=1

# user (auto mount by recovery itself by target address)
/data                    f2fs      /dev/block/by-name/userdata                              flags=fileencryption=aes-256-xts:aes-256-cts:v1
/metadata                ext4      /dev/block/by-name/md_udc                                flags=display="Metadata";wipeingui
/cache                   ext4      /dev/block/by-name/cache                                 flags=display="Cache";wipeingui

# firmware (added bootloader flash)
/recovery                emmc      /dev/block/by-name/recovery                              flags=display="Recovery";backup=1;flashimg=1
/boot                    emmc      /dev/block/by-name/boot                                  flags=display="Boot";backup=1;flashimg=1
/dtbo                    emmc      /dev/block/by-name/dtbo                                  flags=display="Dtbo";backup=1;flashimg=1
/bootloader              emmc      /dev/block/by-name/lk          /dev/block/by-name/lk2    flags=display="Bootloader";backup=1;flashimg=1
/logo                    emmc      /dev/block/by-name/logo                                  flags=display="Splash";backup=1;flashimg=1
/vbmeta                  emmc      /dev/block/by-name/vbmeta                                flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_system           emmc      /dev/block/by-name/vbmeta_system                         flags=display="Vbmeta System";backup=1;flashimg=1
/vbmeta_vendor           emmc      /dev/block/by-name/vbmeta_vendor                         flags=display="Vbmeta Vendor";backup=1;flashimg=1

# modem (added md1mg and changed nvdata, nvcfg, protect fstypes with backup option)
/protect_f               ext4      /dev/block/by-name/protect1                              flags=display="protect_f";backup=1
/protect_s               ext4      /dev/block/by-name/protect2                              flags=display="protect_s";backup=1
/nvram                   emmc      /dev/block/by-name/nvram                                 flags=display="nvram";backup=1
/nvdata                  ext4      /dev/block/by-name/nvdata                                flags=display="nvdata";backup=1
/nvcfg                   ext4      /dev/block/by-name/nvcfg                                 flags=display="nvcfg";backup=1
/proinfo                 emmc      /dev/block/by-name/proinfo                               flags=display="proinfo";backup=1
/oppo_custom             emmc      /dev/block/by-name/oppo_custom                           flags=display="oppo_custom";backup=1
/md1img                  emmc      /dev/block/by-name/md1img                                flags=display="md1img";backup=1

# firmware (changed persist ext4)
/persist                 ext4      /dev/block/by-name/persist         
/tee1                    emmc      /dev/block/by-name/tee1        
/tee2                    emmc      /dev/block/by-name/tee2        
/persistent              emmc      /dev/block/by-name/frp           
/expdb                   emmc      /dev/block/by-name/expdb
/seccfg                  emmc      /dev/block/by-name/seccfg
/para                    emmc      /dev/block/by-name/para

# removable (auto mount by recovery itself by target address)
/external_sd        auto      /dev/block/mmcblk1p1        /dev/block/mmcblk1            flags=display="Micro SD";storage;removable
/usb_otg            auto      /dev/block/sda1             /dev/block/sda                flags=display="USB OTG";storage;removable
